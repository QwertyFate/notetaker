# Copy to .env (gitignored) and fill in. Loaded automatically for the Claude notes step.
ANTHROPIC_API_KEY=sk-ant-...

# Optional
# NOTETAKER_CLAUDE_MODEL=claude-opus-5-5
# NOTETAKER_CLAUDE_EFFORT=medium
# NOTETAKER_WHISPER_MODEL=large-v3-turbo   # "small" is ~2.5x faster, lower quality
# NOTETAKER_WHISPER_THREADS=8
# NOTETAKER_LANGUAGE=de                    # force one language; default detects per segment
# NOTETAKER_HOST=127.0.0.1                 # 0.0.0.0 accepts other machines; only once the API has auth
# NOTETAKER_PORT=8333

# CRM route (see README "CRM route")
# NOTETAKER_CRM_TOKEN=change-me-long-random      # require "Authorization: Bearer <token>" on /crm/*
# NOTETAKER_WEBHOOK_SECRET=change-me-long-random # sign callbacks (X-Notetaker-Signature)
# NOTETAKER_CALLBACK_HOSTS=localhost,127.0.0.1,::1
# NOTETAKER_JOIN_LEAD_SECONDS=60                 # scheduled bots leave this long before join_at
# NOTETAKER_MISSED_AFTER_MINUTES=30              # after a restart, still join meetings this late

# Recording notice the bot posts and pins in the meeting chat. Empty value = no notice.
# Default (German):
# NOTETAKER_CHAT_MESSAGE=Hallo, ich bin Notetaker. Dieses Meeting wird gemäß unserer Richtlinie zur Aufzeichnung von Meetings aufgezeichnet und transkribiert, um Notizen zu erstellen. Wenn Sie keine Aufzeichnung wünschen, kann der Host mich aus dem Meeting entfernen.
# English example:
# NOTETAKER_CHAT_MESSAGE=Hi, I'm Notetaker. This meeting is being recorded and transcribed for note-taking purposes, in line with our recording policy. If you don't want this meeting recorded, the host can remove me from the call.

# Health check (GET /crm/health)
# NOTETAKER_MAX_BOTS=5                           # bots in calls at once before health reports "full"
# NOTETAKER_MIN_FREE_GB=2                        # free disk below which health reports "disk_low"

# Upload transcription (POST /crm/transcribe)
# NOTETAKER_MAX_UPLOAD_MB=500
